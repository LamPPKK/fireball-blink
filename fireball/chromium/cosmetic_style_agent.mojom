module fireball.mojom;

// 256 KiB of validated token bytes plus one uint16 length per token.
const uint32 kCosmeticDomSnapshotWireBytes = 270336;

// A frame-associated, typed renderer interface. It carries only validated CSS
// and an opaque Fireball DocumentId; it never accepts JavaScript or page HTML.
enum CosmeticStyleLayer {
  kDocument,
  kGeneric,
};

interface CosmeticStyleAgent {
  // Renderer-owned and incremented for every new Blink document. The browser
  // must discard the reply if its document-scoped WeakDocumentPtr expired.
  GetDocumentEpoch() => (uint64 document_epoch);
  // Every successful bind rotates a renderer-owned generation. Mutations must
  // echo both values so queued messages from an older remote fail closed even
  // when BFCache restores the same Blink document and Fireball DocumentId.
  // The first DocumentId claim remains locked until a new Blink document.
  BindDocument(string document_id,
               uint64 expected_document_epoch) =>
      (bool bound, uint64 binding_generation);
  SetStylesheet(string document_id,
                uint64 expected_document_epoch,
                uint64 expected_binding_generation,
                CosmeticStyleLayer layer,
                string stylesheet) => (bool applied);
  // Returns a bounded, deduplicated light-DOM snapshot. A limit result is
  // distinct from an identity failure so the browser can retain the already
  // acknowledged document-specific stylesheet while skipping generic rules.
  CollectDomSnapshot(string document_id,
                     uint64 expected_document_epoch,
                     uint64 expected_binding_generation) =>
      (bool collected,
       bool limit_exceeded,
       uint64 revision,
       uint32 payload_size,
       uint32 class_count,
       uint32 id_count,
       array<uint8, kCosmeticDomSnapshotWireBytes> payload);
  RemoveDocumentStyles(string document_id,
                       uint64 expected_document_epoch,
                       uint64 expected_binding_generation) => (bool removed);
};
