{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fireball.example/schemas/adblock-source-lock-v1.schema.json",
  "title": "Fireball adblock source lock v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sources"],
  "properties": {
    "schema_version": { "const": 1 },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "url", "revision", "license", "path", "sha256"],
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$" },
          "url": { "type": "string", "pattern": "^https://" },
          "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "license": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$" },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(/|$))(?!.*\\\\).+$"
          },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
