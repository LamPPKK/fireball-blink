[Desktop Entry]
Version=1.0
Name=Fireball Browser
GenericName=Web Browser
Comment=Fast, Private, Multi-Tier Web Browser
Exec=/usr/bin/fireball %U
Terminal=false
X-MultipleArgs=false
Type=Application
Icon=fireball
Categories=Network;WebBrowser;
MimeType=text/html;text/xml;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;x-scheme-handler/fireball;
StartupWMClass=Fireball
StartupNotify=true
Actions=new-window;new-private-window;

[Desktop Action new-window]
Name=New Window
Exec=/usr/bin/fireball --new-window

[Desktop Action new-private-window]
Name=New Incognito Window
Exec=/usr/bin/fireball --incognito
